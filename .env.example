# ==============================================================================
# Environment Configuration Template for BtoanAiNet
# Copy this file to .env or configure in your hosting platform (Render/Docker)
# ==============================================================================

# ASP.NET Core Runtime
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Database Provider ('SqlServer' or 'MySql')
DbProvider=SqlServer
ConnectionStrings__DefaultConnection=Server=localhost;Database=btoan_ai;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;

# Qdrant Vector Database (Semantic RAG)
Qdrant__Endpoint=http://localhost:6333
Qdrant__ApiKey=

# MassTransit / RabbitMQ (Leave empty for In-Memory message bus)
RabbitMQ__Host=
RabbitMQ__User=guest
RabbitMQ__Pass=guest

# Docker Sandbox Settings
DockerSandbox__DefaultImage=mcr.microsoft.com/dotnet/sdk:10.0-alpine
DockerSandbox__MemoryLimit=512m
DockerSandbox__CpuLimit=1.0
DockerSandbox__ExecutionTimeoutSeconds=45
DockerSandbox__AllowNetworkAccess=false

