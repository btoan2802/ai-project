@inject shop_senior_mvc.Services.CartService CartSvc
@using shop_senior_mvc.Helpers
@{
    bool isLoggedIn = Context.Session.IsUserLoggedIn();
    string username = Context.Session.GetString("Username") ?? "Khách hàng";
    string userRole = Context.Session.GetString("UserRole") ?? "";
    bool isAdmin = userRole == "Admin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sneaker Shop Senior</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background: #0f172a; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; min-height: 100vh; display: flex; flex-direction: column; }
        .navbar { background: #1e293b !important; border-bottom: 1px solid #334155; }
        .card { background: #1e293b; border: 1px solid #334155; color: #f8fafc; border-radius: 1rem; }
        .btn-primary { background: #3b82f6; border-color: #3b82f6; }
        .btn-primary:hover { background: #2563eb; }
        .footer { background: #0f172a; border-top: 1px solid #1e293b; color: #94a3b8; margin-top: auto; }
        .price-badge { font-weight: 700; color: #38bdf8; font-size: 1.15rem; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                <i class="bi bi-lightning-charge-fill me-1"></i>SNEAKER SHOP
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link text-white" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-warning fw-bold" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản trị
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Products"><i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt me-2"></i>Quản lý đơn hàng</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-light position-relative rounded-pill px-3 py-1.5">
                        <i class="bi bi-cart3 me-1"></i>Giỏ hàng
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @(CartSvc.GetTotalItems())
                        </span>
                    </a>

                    @if (isLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="btn btn-outline-info rounded-pill px-3 py-1.5 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@username
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Trang cá nhân & Đơn hàng</a></li>
                                @if (isAdmin)
                                {
                                    <li><a class="dropdown-item text-warning" asp-controller="Admin" asp-action="Index"><i class="bi bi-shield-check me-2"></i>Vào trang Quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider border-secondary" /></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary rounded-pill px-3 py-1.5">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary rounded-pill px-3 py-1.5">
                                Đăng ký
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container py-4 flex-grow-1">
        @RenderBody()
    </div>

    <footer class="footer py-4 text-center">
        <div class="container">
            <p class="mb-0">© 2026 Sneaker Shop Senior — Xây dựng trên ASP.NET Core & SQLite bởi Btoan Studio IDE</p>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
