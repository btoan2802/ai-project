@model shop_senior_mvc.Models.User
@{
    ViewData["Title"] = "Trang cá nhân";
    var orders = ViewBag.Orders as List<shop_senior_mvc.Models.Order> ?? new List<shop_senior_mvc.Models.Order>();
}

<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card p-4 shadow">
            <div class="text-center mb-3">
                <div class="bg-primary bg-opacity-25 text-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:72px;height:72px;font-size:2rem;">
                    <i class="bi bi-person"></i>
                </div>
                <h4 class="fw-bold mt-2 mb-0">@(Model?.Username ?? "Khách hàng")</h4>
                <div class="badge bg-secondary mt-1">@(Model?.Role ?? "Customer")</div>
            </div>
            <div class="border-top border-secondary pt-3 small text-secondary">
                <div class="mb-2"><strong>Email:</strong> @(Model?.Email)</div>
                <div class="mb-2"><strong>Ngày tham gia:</strong> @(Model?.CreatedAt.ToString("dd/MM/yyyy"))</div>
            </div>
            <div class="mt-3">
                <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger w-100 btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card p-4 shadow">
            <h4 class="fw-bold text-primary mb-3">
                <i class="bi bi-bag-check-fill me-2"></i>Lịch sử đơn hàng của bạn
            </h4>

            @if (orders.Count == 0)
            {
                <div class="text-center py-5 text-secondary">
                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                    Bạn chưa có đơn hàng nào.
                    <div class="mt-3">
                        <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-sm rounded-pill">
                            <i class="bi bi-bag-plus me-1"></i>Khám phá mua sắm ngay
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle mb-0">
                        <thead>
                            <tr class="text-secondary small">
                                <th>Mã đơn</th>
                                <th>Ngày đặt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orders)
                            {
                                <tr>
                                    <td class="fw-bold text-info">#@o.Id</td>
                                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold text-success">@o.TotalAmount.ToString("N0") đ</td>
                                    <td>
                                        <span class="badge @(o.Status == "Đã giao" ? "bg-success" : "bg-warning text-dark")">
                                            @o.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
