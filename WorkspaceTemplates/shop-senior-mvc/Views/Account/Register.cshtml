@model shop_senior_mvc.Models.User
@{
    ViewData["Title"] = "Đăng ký";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card p-4 shadow">
            <h3 class="fw-bold text-center text-primary mb-3">
                <i class="bi bi-person-plus-fill me-2"></i>Đăng ký tài khoản
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 extra-small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label text-secondary small">Họ và tên</label>
                    <input asp-for="Username" class="form-control bg-dark text-white border-secondary" placeholder="Ví dụ: Nguyễn Văn A" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary small">Email</label>
                    <input asp-for="Email" type="email" class="form-control bg-dark text-white border-secondary" placeholder="email@domain.com" required />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary small">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control bg-dark text-white border-secondary" placeholder="Tối thiểu 6 ký tự" required />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary fw-semibold py-2">
                        <i class="bi bi-person-check-fill me-1"></i>Tạo tài khoản
                    </button>
                </div>
            </form>

            <div class="text-center mt-3 small text-secondary">
                Đã có tài khoản? <a asp-action="Login" class="text-info text-decoration-none fw-semibold">Đăng nhập ngay</a>
            </div>
        </div>
    </div>
</div>
