@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card p-4 shadow">
            <h3 class="fw-bold text-center text-primary mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Đăng nhập
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 extra-small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>@ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post">
                <div class="mb-3">
                    <label class="form-label text-secondary small">Email</label>
                    <input type="email" name="email" class="form-control bg-dark text-white border-secondary" placeholder="admin@btoan.com hoặc khachhang@btoan.com" required />
                </div>
                <div class="mb-3">
                    <label class="form-label text-secondary small">Mật khẩu</label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="Nhập mật khẩu (123456)" required />
                </div>
                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary fw-semibold py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                    </button>
                </div>
            </form>

            <div class="mt-4 p-3 bg-black bg-opacity-25 rounded small text-secondary">
                <div class="fw-bold text-info mb-1"><i class="bi bi-info-circle me-1"></i>Tài khoản mẫu có sẵn:</div>
                <div>• Admin: <code>admin@btoan.com</code> / <code>123456</code></div>
                <div>• Khách hàng: <code>khachhang@btoan.com</code> / <code>123456</code></div>
            </div>

            <div class="text-center mt-3 small text-secondary">
                Chưa có tài khoản? <a asp-action="Register" class="text-info text-decoration-none fw-semibold">Đăng ký ngay</a>
            </div>
        </div>
    </div>
</div>
