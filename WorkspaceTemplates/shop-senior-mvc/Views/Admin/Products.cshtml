@model List<shop_senior_mvc.Models.Product>
@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-primary mb-1">
            <i class="bi bi-box-seam me-2"></i>Quản lý sản phẩm
        </h2>
        <p class="text-secondary small mb-0">Danh sách giày và sản phẩm đang bán trên hệ thống</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Về Dashboard
        </a>
        <a asp-action="CreateProduct" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="bi bi-plus-circle me-1"></i>Thêm sản phẩm mới
        </a>
    </div>
</div>

<div class="card p-4 shadow">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr class="text-secondary small">
                    <th style="width: 70px;">Hình</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th>Đơn giá</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <img src="@p.ImageUrl" alt="@p.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" />
                        </td>
                        <td class="fw-bold">@p.Name</td>
                        <td><span class="badge bg-secondary">@(p.Category?.Name ?? "Sneakers")</span></td>
                        <td class="fw-bold text-info">@p.Price.ToString("N0") đ</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil me-1"></i>Sửa
                                </a>
                                <form asp-action="DeleteProduct" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
