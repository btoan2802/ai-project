    <!-- Safety Fallbacks & Scripts -->
    <script>
        window.openRightAgentPanel = window.openRightAgentPanel || function () {
            const panel = document.getElementById("rightAgentPanel");
            const resizer = document.getElementById("resizerAgent");
            if (!panel) return;
            panel.classList.remove("ide-panel-hidden", "d-none");
            panel.style.display = "flex";
            if (panel.style.width === "0px" || panel.offsetWidth < 50) {
                panel.style.width = "420px";
            }
            if (resizer) resizer.style.display = "block";
            if (typeof triggerEditorLayout === "function") triggerEditorLayout();
        };

        window.askAgentToFixTerminalError = window.askAgentToFixTerminalError || function () {
            if (typeof window.openRightAgentPanel === "function") {
                window.openRightAgentPanel();
            }
            let terminalLogs = "";
            try {
                const session = (typeof terminalSessions !== "undefined" && Array.isArray(terminalSessions) && terminalSessions.length > 0)
                    ? (terminalSessions.find(s => s.id === activeTerminalSessionId) || terminalSessions[0])
                    : null;
                const targetXterm = (session && session.xterm) ? session.xterm : (typeof xtermInstance !== "undefined" ? xtermInstance : null);

                if (targetXterm && targetXterm.buffer && targetXterm.buffer.active) {
                    const buffer = targetXterm.buffer.active;
                    const lines = [];
                    const total = buffer.length;
                    const start = Math.max(0, total - 50);
                    for (let i = start; i < total; i++) {
                        const line = buffer.getLine(i);
                        if (line) {
                            const str = line.translateToString(true);
                            if (str && str.trim()) lines.push(str);
                        }
                    }
                    terminalLogs = lines.join('\n');
                }
            } catch (e) { }

            if (!terminalLogs || terminalLogs.trim().length === 0) {
                if (window.lastTerminalErrorSnippet) terminalLogs = window.lastTerminalErrorSnippet;
            }

            terminalLogs = (terminalLogs || "")
                .replace(/\x1b\[[0-9;]*[a-zA-Z]/g, '')
                .replace(/[\u001b\u009b][[()#;?]*(?:[0-9]{1,4}(?:;[0-9]{0,4})*)?[0-9A-ORZcf-nqry=><]/g, '')
                .trim();

            const input = document.getElementById("agentTaskInput");
            if (!terminalLogs) {
                if (typeof showToastNotification === "function") {
                    showToastNotification("Terminal hiện chưa có log lỗi để gửi.");
                }
                if (input) input.focus();
                return;
            }

            const promptText = `Hãy kiểm tra và sửa triệt để lỗi biên dịch/chạy sau trong dự án:\n\`\`\`\n${terminalLogs}\n\`\`\``;
            if (input) {
                input.value = promptText;
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.focus();
                if (typeof sendAgentTask === "function") {
                    sendAgentTask();
                }
            }

            const fixBtn = document.getElementById("btnAskAgentFixTerminal") || document.getElementById("btnTerminalAskAgentFix");
            if (fixBtn) fixBtn.classList.remove("pulse-fix-btn");
        };
    </script>
