@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Btoan Studio IDE - Btoan Agent</title>
    <meta name="description" content="Btoan Studio IDE - Môi trường lập trình Web & App tự động bằng AI Agent. Scaffold dự án, viết code Senior Architect, Database SQLite và Live Preview trực tiếp." />
    
    <!-- Open Graph / Facebook / Zalo / Messenger -->
    <meta property="og:site_name" content="Btoan Studio IDE" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ai.btoan.com/agent" />
    <meta property="og:title" content="Btoan Studio IDE — AI Agent Tự Động Viết Code & Build Dự Án" />
    <meta property="og:description" content="Lập trình tự động cùng Btoan AI Agent: Scaffold ASP.NET Core MVC, Web API, Angular; Database SQLite thật; Terminal & Live Web Preview trực tiếp." />
    <meta property="og:image" content="https://ai.btoan.com/images/og-agent-preview.png" />
    <meta property="og:image:secure_url" content="https://ai.btoan.com/images/og-agent-preview.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Btoan Studio IDE — AI Agent Tự Động Viết Code & Build Dự Án" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Btoan Studio IDE — AI Agent Tự Động Viết Code & Build Dự Án" />
    <meta name="twitter:description" content="Lập trình tự động cùng Btoan AI Agent: Scaffold ASP.NET Core MVC, Web API, Angular; Database SQLite thật; Terminal & Live Web Preview trực tiếp." />
    <meta name="twitter:image" content="https://ai.btoan.com/images/og-agent-preview.png" />

    <link rel="icon" type="image/svg+xml" href="/images/btoan-logo.svg?v=20261128_v50" />

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Load Bootstrap JS BEFORE Monaco AMD Loader to prevent AMD define conflict -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        if (typeof window !== 'undefined' && typeof bootstrap !== 'undefined') {
            window.bootstrap = bootstrap;
        }
    </script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- xterm.js & FitAddon CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@xterm/xterm@@5.5.0/css/xterm.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@xterm/xterm@@5.5.0/lib/xterm.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@xterm/addon-fit@@0.10.0/lib/addon-fit.min.js"></script>

    <!-- Microsoft SignalR CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>

    <!-- Monaco Editor AMD Loader -->
    <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.52.0/min/vs/loader.js"></script>

    <!-- Btoan Studio IDE Dark Modern CSS -->
    <link rel="stylesheet" href="~/css/agent_ide.css?v=20261128_v50" asp-append-version="true" />
    <style>
        @@keyframes pulseFixBtn {
            0% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0.7); border-color: #f59e0b; }
            70% { box-shadow: 0 0 0 7px rgba(234, 179, 8, 0); border-color: #fbbf24; }
            100% { box-shadow: 0 0 0 0 rgba(234, 179, 8, 0); border-color: #f59e0b; }
        }
        .pulse-fix-btn {
            animation: pulseFixBtn 1.6s infinite ease-in-out !important;
            background: rgba(245, 158, 11, 0.2) !important;
            color: #fef08a !important;
            border-color: #f59e0b !important;
        }
    </style>
</head>
<body class="agent-ide-body">

    <!-- 1. TOP MENU / TITLE BAR (Height 35px, #181818) -->
    <header class="vscode-top-bar">
        <!-- Left: Navigation, Menus & Navigation History -->
        <div class="d-flex align-items-center gap-1">
            <a href="/" class="top-nav-back-btn" title="Quay lại giao diện Chat">
                <i class="bi bi-arrow-left me-1"></i> <span>Chat</span>
            </a>
            <a href="/" class="top-menu-brand me-1 d-inline-flex align-items-center text-decoration-none" title="Về trang chủ Btoan AI">
                <img src="/images/btoan-logo.svg?v=20261128_v50" width="22" height="22" alt="Btoan AI" style="filter: drop-shadow(0 2px 6px rgba(99,102,241,0.5));">
            </a>
            <!-- Menus with Interactive Dropdowns -->
            <div class="top-bar-menus position-relative">
                <!-- File Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('file', event)" onmouseenter="onMenuItemHover('file')">File</span>
                    <div id="topMenuFile" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="openCreateFileModal(); closeAllTopMenus();">
                            <span><i class="bi bi-file-earmark-plus me-2 text-primary"></i>New File...</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="openCreateFolderModal(); closeAllTopMenus();">
                            <span><i class="bi bi-folder-plus me-2 text-warning"></i>New Folder...</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="triggerFolderUpload(); closeAllTopMenus();">
                            <span><i class="bi bi-cloud-arrow-up me-2 text-info"></i>Upload Folder...</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="triggerFilesUpload(); closeAllTopMenus();">
                            <span><i class="bi bi-file-earmark-arrow-up me-2 text-info"></i>Upload Files...</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="saveCurrentFile(); closeAllTopMenus();">
                            <span><i class="bi bi-save me-2 text-success"></i>Save</span>
                            <span class="dropdown-shortcut">Ctrl+S</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="saveAllDirtyFiles(); closeAllTopMenus();">
                            <span><i class="bi bi-files me-2 text-info"></i>Save All</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+S</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="toggleAutoSave(); closeAllTopMenus();">
                            <span><i id="autoSaveCheckIcon" class="bi bi-check2 me-2 text-success" style="visibility: hidden;"></i>Auto Save</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="downloadCurrentProjectZip(); closeAllTopMenus();">
                            <span><i class="bi bi-file-earmark-zip me-2 text-warning"></i>Download Project (.zip)</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="closeCurrentTab(); closeAllTopMenus();">
                            <span><i class="bi bi-x-circle me-2 text-secondary"></i>Close Editor</span>
                            <span class="dropdown-shortcut">Ctrl+W</span>
                        </div>
                    </div>
                </div>

                <!-- Edit Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('edit', event)" onmouseenter="onMenuItemHover('edit')">Edit</span>
                    <div id="topMenuEdit" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="editorUndo(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-counterclockwise me-2 text-info"></i>Undo</span>
                            <span class="dropdown-shortcut">Ctrl+Z</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorRedo(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-clockwise me-2 text-info"></i>Redo</span>
                            <span class="dropdown-shortcut">Ctrl+Y</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="editorCut(); closeAllTopMenus();">
                            <span><i class="bi bi-scissors me-2 text-secondary"></i>Cut</span>
                            <span class="dropdown-shortcut">Ctrl+X</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorCopy(); closeAllTopMenus();">
                            <span><i class="bi bi-clipboard me-2 text-secondary"></i>Copy</span>
                            <span class="dropdown-shortcut">Ctrl+C</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorPaste(); closeAllTopMenus();">
                            <span><i class="bi bi-clipboard-check me-2 text-secondary"></i>Paste</span>
                            <span class="dropdown-shortcut">Ctrl+V</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="editorFind(); closeAllTopMenus();">
                            <span><i class="bi bi-search me-2 text-primary"></i>Find</span>
                            <span class="dropdown-shortcut">Ctrl+F</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorReplace(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-repeat me-2 text-warning"></i>Replace</span>
                            <span class="dropdown-shortcut">Ctrl+H</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="switchActivityTab('search'); closeAllTopMenus();">
                            <span><i class="bi bi-search me-2 text-primary"></i>Find in Files</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+F</span>
                        </div>
                    </div>
                </div>

                <!-- Selection Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('selection', event)" onmouseenter="onMenuItemHover('selection')">Selection</span>
                    <div id="topMenuSelection" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="editorSelectAll(); closeAllTopMenus();">
                            <span><i class="bi bi-check-all me-2 text-primary"></i>Select All</span>
                            <span class="dropdown-shortcut">Ctrl+A</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorExpandSelection(); closeAllTopMenus();">
                            <span><i class="bi bi-arrows-angle-expand me-2 text-info"></i>Expand Selection</span>
                            <span class="dropdown-shortcut">Shift+Alt+→</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorShrinkSelection(); closeAllTopMenus();">
                            <span><i class="bi bi-arrows-angle-contract me-2 text-info"></i>Shrink Selection</span>
                            <span class="dropdown-shortcut">Shift+Alt+←</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="editorCopyLineUp(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-up-square me-2 text-secondary"></i>Copy Line Up</span>
                            <span class="dropdown-shortcut">Shift+Alt+↑</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorCopyLineDown(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-down-square me-2 text-secondary"></i>Copy Line Down</span>
                            <span class="dropdown-shortcut">Shift+Alt+↓</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorMoveLineUp(); closeAllTopMenus();">
                            <span><i class="bi bi-chevron-up me-2 text-secondary"></i>Move Line Up</span>
                            <span class="dropdown-shortcut">Alt+↑</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorMoveLineDown(); closeAllTopMenus();">
                            <span><i class="bi bi-chevron-down me-2 text-secondary"></i>Move Line Down</span>
                            <span class="dropdown-shortcut">Alt+↓</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="editorAddCursorAbove(); closeAllTopMenus();">
                            <span><i class="bi bi-cursor-fill me-2 text-warning"></i>Add Cursor Above</span>
                            <span class="dropdown-shortcut">Ctrl+Alt+↑</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorAddCursorBelow(); closeAllTopMenus();">
                            <span><i class="bi bi-cursor me-2 text-warning"></i>Add Cursor Below</span>
                            <span class="dropdown-shortcut">Ctrl+Alt+↓</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorSelectNextOccurrence(); closeAllTopMenus();">
                            <span><i class="bi bi-list-check me-2 text-success"></i>Add Next Occurrence</span>
                            <span class="dropdown-shortcut">Ctrl+D</span>
                        </div>
                    </div>
                </div>

                <!-- View Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('view', event)" onmouseenter="onMenuItemHover('view')">View</span>
                    <div id="topMenuView" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="openQuickOpenModal(); closeAllTopMenus();">
                            <span><i class="bi bi-terminal me-2 text-primary"></i>Command Palette...</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+P</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="switchActivityTab('explorer'); closeAllTopMenus();">
                            <span><i class="bi bi-files me-2 text-secondary"></i>Explorer</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+E</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="switchActivityTab('search'); closeAllTopMenus();">
                            <span><i class="bi bi-search me-2 text-secondary"></i>Search</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+F</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="switchActivityTab('git'); closeAllTopMenus();">
                            <span><i class="bi bi-git me-2 text-secondary"></i>Source Control</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+G</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="switchActivityTab('run'); closeAllTopMenus();">
                            <span><i class="bi bi-play-circle me-2 text-secondary"></i>Run & Debug</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+D</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="toggleLeftSidebar(); closeAllTopMenus();">
                            <span><i class="bi bi-layout-sidebar me-2 text-info"></i>Toggle Primary Sidebar</span>
                            <span class="dropdown-shortcut">Ctrl+B</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="toggleBottomPanel(); closeAllTopMenus();">
                            <span><i class="bi bi-layout-split me-2 text-info"></i>Toggle Panel</span>
                            <span class="dropdown-shortcut">Ctrl+J</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="toggleRightAgentPanel(); closeAllTopMenus();">
                            <span><i class="bi bi-stars me-2 text-info"></i>Toggle Btoan Agent</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="toggleWordWrap(); closeAllTopMenus();">
                            <span><i class="bi bi-text-wrap me-2 text-warning"></i>Toggle Word Wrap</span>
                            <span class="dropdown-shortcut">Alt+Z</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="toggleMinimap(); closeAllTopMenus();">
                            <span><i class="bi bi-map me-2 text-warning"></i>Toggle Minimap</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="zoomInEditor(); closeAllTopMenus();">
                            <span><i class="bi bi-zoom-in me-2 text-light"></i>Zoom In</span>
                            <span class="dropdown-shortcut">Ctrl+=</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="zoomOutEditor(); closeAllTopMenus();">
                            <span><i class="bi bi-zoom-out me-2 text-light"></i>Zoom Out</span>
                            <span class="dropdown-shortcut">Ctrl+-</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="resetZoomEditor(); closeAllTopMenus();">
                            <span><i class="bi bi-aspect-ratio me-2 text-light"></i>Reset Zoom</span>
                            <span class="dropdown-shortcut">Ctrl+0</span>
                        </div>
                    </div>
                </div>

                <!-- Go Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('go', event)" onmouseenter="onMenuItemHover('go')">Go</span>
                    <div id="topMenuGo" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="openQuickOpenModal(); closeAllTopMenus();">
                            <span><i class="bi bi-file-earmark me-2 text-primary"></i>Go to File...</span>
                            <span class="dropdown-shortcut">Ctrl+P</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorGotoLine(); closeAllTopMenus();">
                            <span><i class="bi bi-list-ol me-2 text-info"></i>Go to Line/Column...</span>
                            <span class="dropdown-shortcut">Ctrl+G</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="editorGotoSymbol(); closeAllTopMenus();">
                            <span><i class="bi bi-braces me-2 text-warning"></i>Go to Symbol in Editor...</span>
                            <span class="dropdown-shortcut">Ctrl+Shift+O</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="navigateTabBack(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-left me-2 text-secondary"></i>Back</span>
                            <span class="dropdown-shortcut">Alt+←</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="navigateTabForward(); closeAllTopMenus();">
                            <span><i class="bi bi-arrow-right me-2 text-secondary"></i>Forward</span>
                            <span class="dropdown-shortcut">Alt+→</span>
                        </div>
                    </div>
                </div>

                <!-- Run Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('run', event)" onmouseenter="onMenuItemHover('run')">Run</span>
                    <div id="topMenuRun" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="runBuildInTerminal(); closeAllTopMenus();">
                            <span><i class="bi bi-play-fill me-2 text-success"></i>Build Project</span>
                            <span class="dropdown-shortcut">dotnet build</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="runSmartAction(); closeAllTopMenus();">
                            <span><i class="bi bi-lightning-charge me-2 text-warning"></i>Run Current File / App</span>
                            <span class="dropdown-shortcut">F5</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="runTestInTerminal(); closeAllTopMenus();">
                            <span><i class="bi bi-check2-circle me-2 text-info"></i>Run Tests</span>
                            <span class="dropdown-shortcut">dotnet test</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="runCustomTerminalCmd('dotnet --version'); closeAllTopMenus();">
                            <span><i class="bi bi-info-circle me-2 text-info"></i>Check .NET Version</span>
                            <span class="dropdown-shortcut">dotnet --version</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="clearTerminalOutput(); closeAllTopMenus();">
                            <span><i class="bi bi-trash me-2 text-secondary"></i>Clear Terminal</span>
                        </div>
                    </div>
                </div>

                <!-- Terminal Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('terminal', event)" onmouseenter="onMenuItemHover('terminal')">Terminal</span>
                    <div id="topMenuTerminal" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="switchBottomTab('terminal'); closeAllTopMenus();">
                            <span><i class="bi bi-terminal me-2 text-info"></i>New Terminal</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="toggleBottomPanel(); closeAllTopMenus();">
                            <span><i class="bi bi-layout-split me-2 text-secondary"></i>Toggle Terminal Panel</span>
                            <span class="dropdown-shortcut">Ctrl+J</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="clearTerminalOutput(); closeAllTopMenus();">
                            <span><i class="bi bi-trash me-2 text-secondary"></i>Clear Terminal</span>
                        </div>
                    </div>
                </div>

                <!-- Help Menu -->
                <div class="top-bar-menu-wrapper">
                    <span class="top-bar-menu-item" onclick="toggleTopMenu('help', event)" onmouseenter="onMenuItemHover('help')">Help</span>
                    <div id="topMenuHelp" class="top-bar-dropdown-menu">
                        <div class="top-bar-dropdown-item" onclick="showHelpQuickStart(); closeAllTopMenus();">
                            <span><i class="bi bi-book me-2 text-primary"></i>Welcome & Quick Start</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="showHelpShortcuts(); closeAllTopMenus();">
                            <span><i class="bi bi-keyboard me-2 text-info"></i>Keyboard Shortcuts Reference</span>
                        </div>
                        <div class="top-bar-dropdown-item" onclick="showHelpStatus(); closeAllTopMenus();">
                            <span><i class="bi bi-activity me-2 text-success"></i>System & Workspace Status</span>
                        </div>
                        <div class="top-bar-dropdown-divider"></div>
                        <div class="top-bar-dropdown-item" onclick="showHelpAbout(); closeAllTopMenus();">
                            <span><i class="bi bi-info-circle me-2 text-warning"></i>About Btoan Studio IDE</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center text-secondary ms-1">
                <button class="btn-top-nav-icon" onclick="navigateTabBack()" title="Go Back (Alt+Left)"><i class="bi bi-chevron-left"></i></button>
                <button class="btn-top-nav-icon" onclick="navigateTabForward()" title="Go Forward (Alt+Right)"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>

        <!-- Center: Dynamic IDE Document Title & Workspace Pill -->
        <div class="d-flex align-items-center justify-content-center flex-grow-1 px-2">
            <div class="top-bar-center-pill" onclick="openQuickOpenModal()">
                <i class="bi bi-folder2-open text-primary me-1.5"></i>
                <span id="topBarTitle">Btoan Studio IDE</span>
                <select id="projectSelect" onchange="onProjectChanged()" class="top-bar-project-select ms-2" onclick="event.stopPropagation()">
                    <option value="">-- Chưa có dự án --</option>
                </select>
            </div>
        </div>

        <!-- Right Side: User Controls, Layout Toggles & Window Controls -->
        <div class="d-flex align-items-center gap-1">
            <button class="btn-top-action" onclick="openQuickOpenModal()" title="Search Files (Ctrl+P)"><i class="bi bi-search"></i></button>
            
            <div id="topUserBadgeContainer">
                <button class="btn-sign-in" onclick="location.href='/?login=1'"><i class="bi bi-person me-1"></i> Sign In</button>
            </div>

            <div class="top-bar-divider"></div>

            <div class="d-flex align-items-center gap-0.5 text-secondary">
                <button class="btn-top-action" onclick="toggleLeftSidebar()" title="Toggle Primary Sidebar (Ctrl+B)"><i class="bi bi-layout-sidebar"></i></button>
                <button class="btn-top-action" onclick="toggleBottomPanel()" title="Toggle Bottom Panel (Ctrl+J)"><i class="bi bi-layout-split"></i></button>
                <button class="btn-top-action" onclick="toggleRightAgentPanel()" title="Toggle Btoan Agent"><i class="bi bi-layout-sidebar-reverse"></i></button>
            </div>

            <div class="top-bar-divider"></div>

