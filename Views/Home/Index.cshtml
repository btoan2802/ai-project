  <script src="js/mathjax_config.js?v=20261124"></script>

  <!-- 6. JS Library Cần Load Sớm -->
  <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script>
    window.SERVER_CONVERSATION_ID = '@(ViewBag.ConversationId ?? "")';
    // Early inline definitions to prevent ReferenceError before app.js is ready
    window.syncSidebarChatTitle = window.syncSidebarChatTitle || function(arg1, arg2) {
      if (typeof window.syncSidebarChatTitleImpl === "function") {
        window.syncSidebarChatTitleImpl(arg1, arg2);
      }
    };
    window.toggleTheme = function() {
      const cur = document.documentElement.getAttribute("data-theme") || "light";
      const next = cur === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("appTheme", next);
      const icon = document.getElementById("themeToggleIcon");
      if (icon) icon.className = next === "dark" ? "bi bi-sun-fill fs-6" : "bi bi-moon-stars fs-6";
      const btn = document.getElementById("themeToggleBtn");
      if (btn) btn.title = next === "dark" ? "Chuyển sang giao diện Sáng" : "Chuyển sang giao diện Tối";
    };
    window.toggleUserMenu = function() {
      const m = document.getElementById("userMenu");
      if (m) m.style.display = m.style.display === "block" ? "none" : "block";
    };
    window.closeUserMenu = function() {
      const m = document.getElementById("userMenu");
      if (m) m.style.display = "none";
    };
  </script>
